<!--
    Define all the Components for this install package.  Components are the
    smallest unit that can be installed.  Components can be collected together
    in a ComponentGroup and treated as a single Component.  Components and
    ComponentGroups cannot be nested.
    
    Strings containing square brackets ('[' ']') are in strings that are treated
    as Formatted Text types (a Windows Installer type.  See
    https://learn.microsoft.com/en-us/windows/win32/msi/formatted).
    
    Strings containing $() are a WiX construct and will be replaced by the
    contents of the variable or property described therein (for example,
    $(var.VARIABLE) or $(var.PROJECTNAME.PROPERTY)).  For project properties,
    the project being referenced must be added to the WiX project as a project
    dependency. All variables and property names are case-sensitive.
    
    Wix Documentation for:
    - Component: https://wixtoolset.org/docs/schema/wxs/component/
    - ComponentGroup: https://wixtoolset.org/docs/schema/wxs/componentgroup/
    - File: https://wixtoolset.org/docs/schema/wxs/file/
    - Fragment: https://wixtoolset.org/docs/schema/wxs/fragment/
    - RegistryValue: https://wixtoolset.org/docs/schema/wxs/registryvalue/
    - RemoveFolder: https://wixtoolset.org/docs/schema/wxs/removefolder/
    - Shortcut: https://wixtoolset.org/docs/schema/wxs/shortcut/
-->

<!--
    Bring in globally defined variables for this project.
    These are accessed with $(var.NAME).
-->
<?include Predefines.wxi ?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <Fragment>
        <ComponentGroup Id="Components" >
            <Component Guid="$(var.ProductComponentGUID)" Directory="INSTALLFOLDER">
                <!-- EXE – KeyPath="yes" so the component key path is the file itself -->
                <File Id="SparkleShareAppexe" Source="$(var.SparkleShare.Avalonia.TargetDir)SparkleShare.Avalonia.exe" Checksum="yes" />
                <!-- Application DLLs -->
                <File Source="$(var.SparkleShare.Avalonia.TargetDir)SparkleShare.Avalonia.dll" Checksum="yes" />
                <File Source="$(var.SparkleShare.Avalonia.TargetDir)Sparkles.dll" Checksum="yes" />
                <File Source="$(var.SparkleShare.Avalonia.TargetDir)Sparkles.Git.dll" Checksum="yes" />
                <!-- Avalonia framework DLLs -->
                <File Source="$(var.SparkleShare.Avalonia.TargetDir)Avalonia.Base.dll" Checksum="yes" />
                <File Source="$(var.SparkleShare.Avalonia.TargetDir)Avalonia.Controls.dll" Checksum="yes" />
                <File Source="$(var.SparkleShare.Avalonia.TargetDir)Avalonia.DesignerSupport.dll" Checksum="yes" />
                <File Source="$(var.SparkleShare.Avalonia.TargetDir)Avalonia.Desktop.dll" Checksum="yes" />
                <File Source="$(var.SparkleShare.Avalonia.TargetDir)Avalonia.Dialogs.dll" Checksum="yes" />
                <File Source="$(var.SparkleShare.Avalonia.TargetDir)Avalonia.dll" Checksum="yes" />
                <File Source="$(var.SparkleShare.Avalonia.TargetDir)Avalonia.Fonts.Inter.dll" Checksum="yes" />
                <File Source="$(var.SparkleShare.Avalonia.TargetDir)Avalonia.FreeDesktop.dll" Checksum="yes" />
                <File Source="$(var.SparkleShare.Avalonia.TargetDir)Avalonia.Markup.dll" Checksum="yes" />
                <File Source="$(var.SparkleShare.Avalonia.TargetDir)Avalonia.Markup.Xaml.dll" Checksum="yes" />
                <File Source="$(var.SparkleShare.Avalonia.TargetDir)Avalonia.Metal.dll" Checksum="yes" />
                <File Source="$(var.SparkleShare.Avalonia.TargetDir)Avalonia.MicroCom.dll" Checksum="yes" />
                <File Source="$(var.SparkleShare.Avalonia.TargetDir)Avalonia.Native.dll" Checksum="yes" />
                <File Source="$(var.SparkleShare.Avalonia.TargetDir)Avalonia.OpenGL.dll" Checksum="yes" />
                <File Source="$(var.SparkleShare.Avalonia.TargetDir)Avalonia.ReactiveUI.dll" Checksum="yes" />
                <File Source="$(var.SparkleShare.Avalonia.TargetDir)Avalonia.Remote.Protocol.dll" Checksum="yes" />
                <File Source="$(var.SparkleShare.Avalonia.TargetDir)Avalonia.Skia.dll" Checksum="yes" />
                <File Source="$(var.SparkleShare.Avalonia.TargetDir)Avalonia.Themes.Fluent.dll" Checksum="yes" />
                <File Source="$(var.SparkleShare.Avalonia.TargetDir)Avalonia.Win32.dll" Checksum="yes" />
                <File Source="$(var.SparkleShare.Avalonia.TargetDir)Avalonia.X11.dll" Checksum="yes" />
                <!-- Third-party DLLs -->
                <File Source="$(var.SparkleShare.Avalonia.TargetDir)DynamicData.dll" Checksum="yes" />
                <File Source="$(var.SparkleShare.Avalonia.TargetDir)HarfBuzzSharp.dll" Checksum="yes" />
                <File Source="$(var.SparkleShare.Avalonia.TargetDir)MicroCom.Runtime.dll" Checksum="yes" />
                <File Source="$(var.SparkleShare.Avalonia.TargetDir)Microsoft.Win32.SystemEvents.dll" Checksum="yes" />
                <File Source="$(var.SparkleShare.Avalonia.TargetDir)ReactiveUI.dll" Checksum="yes" />
                <File Source="$(var.SparkleShare.Avalonia.TargetDir)SkiaSharp.dll" Checksum="yes" />
                <File Source="$(var.SparkleShare.Avalonia.TargetDir)Splat.dll" Checksum="yes" />
                <File Source="$(var.SparkleShare.Avalonia.TargetDir)System.Configuration.ConfigurationManager.dll" Checksum="yes" />
                <File Source="$(var.SparkleShare.Avalonia.TargetDir)System.Diagnostics.EventLog.dll" Checksum="yes" />
                <File Source="$(var.SparkleShare.Avalonia.TargetDir)System.Drawing.Common.dll" Checksum="yes" />
                <File Source="$(var.SparkleShare.Avalonia.TargetDir)System.Private.Windows.Core.dll" Checksum="yes" />
                <File Source="$(var.SparkleShare.Avalonia.TargetDir)System.Reactive.dll" Checksum="yes" />
                <File Source="$(var.SparkleShare.Avalonia.TargetDir)System.Security.Cryptography.ProtectedData.dll" Checksum="yes" />
                <File Source="$(var.SparkleShare.Avalonia.TargetDir)Tmds.DBus.Protocol.dll" Checksum="yes" />
                <!-- Start Menu shortcut to run the program -->
                <Shortcut Id="ApplicationStartMenuShortcut" Directory="ApplicationProgramsFolder" Advertise="no"
                    Icon="icon.ico" Name="$(var.Name)"
                    Description="Launch $(var.Name) application"
                    Target="[!SparkleShareAppexe]"
                    Arguments="--pause"
                    WorkingDirectory="INSTALLFOLDER" />
                    
                <!-- Start Menu shortcut to uninstall the program -->
                <Shortcut Id="UninstallProduct" Directory="ApplicationProgramsFolder" Advertise="no"
                    Icon="icon.ico"
                    Name="$(var.Name) uninstall"
                    Description="Uninstalls $(var.Name)"
                    Target="[System64Folder]msiexec.exe"
                    Arguments="/x [ProductCode]" />
               
                <!--
                    Program folder to remove during uninstall.
                    INSTALLFOLDER defined in Folders.wxs.
                -->
                <RemoveFolder Id="INSTALLFOLDER" On="uninstall" />
                <!--
                    Start Menu folder to remove during uninstall.
                    ApplicationProgramsFolder defined in Folders.wxs.
                -->
                <RemoveFolder Id="ApplicationProgramsFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
                <!--
                    HKCU KeyPath satisfies ICE43: non-advertised shortcuts
                    require the component KeyPath to be under HKCU.
                    Note: A key path must be unique across all components.
                -->
                <RegistryValue Root="HKCU" Key="Software\$(var.Manufacturer)\$(var.Name)" Name="installed" Type="integer" KeyPath="yes" Value="1" />
            </Component>

            <Component Directory="DesktopFolder" Condition="ADDDESKTOPSHORTCUT">
                <!--
                    Desktop shortcut to run the program
                    
                    Note: The target uses [!SparkleShareAppexe] to get around an ICE69
                    warning complaining that [#SparkleShareAppexe] references a file
                    in another component (but both components are in the same
                    feature; if the components were in separate features, the
                    warning would become an error).  Using [!] apparently
                    bypasses the ICE69 check and, in this case, the target is a
                    file not a registry value so [!] is basically treated the
                    same as [#].  Yes, this is a hack.
                -->
                <Shortcut Id="ApplicationDesktopShortcut" Directory="DesktopFolder" Advertise="no"
                    Icon="icon.ico" Name="$(var.Name)"
                    Description="Launch $(var.Name) application"
                    Target="[!SparkleShareAppexe]"
                    Arguments="--pause"
                    WorkingDirectory="INSTALLFOLDER" />
                <RegistryValue Root="HKCU" Key="Software\$(var.Manufacturer)\$(var.Name)" Name="shortcut_installed" Type="integer" Value="1" KeyPath="yes" />

            </Component>                        
        </ComponentGroup>
        <!--
            The key path for this component is the directory/subdirectory name
            of this component.
        
        <Component Id="SparkleShareDocs" Directory="INSTALLFOLDER" Subdirectory="Docs" KeyPath="yes" Guid="$(var.AppDocsGUID)">
            <File Id="readmetxt" Source="$(var.SparkleShare.Avalonia.ProjectDir)\README.md" Checksum="yes" Vital="no" />
        </Component>
        -->
    </Fragment>
</Wix>
